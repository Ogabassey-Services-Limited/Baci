default_platform(:ios)

require "English"

WORKSPACE = "ios/BaciTheEcommerceBuilder.xcworkspace"
SCHEME = "BaciTheEcommerceBuilder"
BUNDLE_ID = "com.ogabassey.baci"
OUTPUT_DIR = File.expand_path("../build", __dir__)
APP_STORE_RELEASE_NOTES_MAX_LENGTH = 4000
APP_STORE_PROCESSING_WAIT_TIMEOUT_SECONDS = 5400
LEGACY_SUPABASE_ANON_KEY_FALLBACK_CUTOFF =
  ENV.fetch("LEGACY_SUPABASE_ANON_KEY_FALLBACK_CUTOFF", "2027-01-01")

def legacy_supabase_anon_key_fallback_cutoff
  cutoff = LEGACY_SUPABASE_ANON_KEY_FALLBACK_CUTOFF.to_s.strip
  unless cutoff.match?(/\A\d{4}-\d{2}-\d{2}\z/)
    UI.user_error!(
      "Invalid LEGACY_SUPABASE_ANON_KEY_FALLBACK_CUTOFF: #{cutoff}. Expected YYYY-MM-DD."
    )
  end

  year, month, day = cutoff.split("-").map(&:to_i)
  Time.utc(year, month, day)
rescue ArgumentError
  UI.user_error!(
    "Invalid LEGACY_SUPABASE_ANON_KEY_FALLBACK_CUTOFF: #{cutoff}. Expected a real YYYY-MM-DD date."
  )
end

def ensure_required_env!(keys)
  missing = keys.select { |key| ENV[key].to_s.strip.empty? }
  return if missing.empty?

  UI.user_error!(
    "Missing required build environment variables: #{missing.join(', ')}. " \
    "These values must be present during xcodebuild so Expo can embed the release JS bundle correctly."
  )
end

def ensure_supabase_client_key_env!
  ensure_required_env!(%w[
    EXPO_PUBLIC_SUPABASE_URL
  ])

  return unless ENV["EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY"].to_s.strip.empty?

  unless ENV["EXPO_PUBLIC_SUPABASE_ANON_KEY"].to_s.strip.empty?
    fallback_cutoff = legacy_supabase_anon_key_fallback_cutoff
    if Time.now.utc >= fallback_cutoff
      UI.user_error!(
        "Legacy EXPO_PUBLIC_SUPABASE_ANON_KEY fallback expired on " \
        "#{fallback_cutoff.strftime('%Y-%m-%d')}. " \
        "Set EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead."
      )
    end

    UI.important(
      "Using legacy EXPO_PUBLIC_SUPABASE_ANON_KEY fallback; migrate mobile-admin builds " \
      "to EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY before end of 2026."
    )
    return
  end

  UI.user_error!(
    "Missing required build environment variable: EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY. " \
    "A legacy EXPO_PUBLIC_SUPABASE_ANON_KEY is accepted through 2026 only."
  )
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_API_KEY_ID"),
    issuer_id: ENV.fetch("ASC_API_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_API_KEY_PATH"),
    duration: 1200,
    in_house: false
  )
end

def upload_ipa_with_altool!(ipa_path)
  absolute_ipa_path = File.expand_path(ipa_path)
  UI.user_error!("Expected IPA does not exist: #{absolute_ipa_path}") unless File.file?(absolute_ipa_path)

  ensure_required_env!(%w[
    ASC_API_KEY_ID
    ASC_API_ISSUER_ID
    ASC_API_KEY_PATH
  ])

  key_path = File.expand_path(ENV.fetch("ASC_API_KEY_PATH"))
  UI.user_error!("ASC_API_KEY_PATH does not exist: #{key_path}") unless File.file?(key_path)

  UI.message("Uploading #{absolute_ipa_path} to TestFlight with xcrun altool")

  command = [
    "xcrun",
    "altool",
    "--upload-app",
    "--file",
    absolute_ipa_path,
    "--type",
    "ios",
    "--apiKey",
    ENV.fetch("ASC_API_KEY_ID"),
    "--apiIssuer",
    ENV.fetch("ASC_API_ISSUER_ID"),
    "--output-format",
    "normal",
    "--show-progress"
  ]
  system({ "API_PRIVATE_KEYS_DIR" => File.dirname(key_path) }, *command)
  status = $CHILD_STATUS
  return if status&.success?

  UI.user_error!("altool upload failed with exit status #{status&.exitstatus || 'unknown'}")
end

def app_store_release_notes(text)
  notes = text.to_s.gsub(/\r\n?/, "\n").strip
  notes = "Bug fixes and performance improvements." if notes.empty?
  notes[0, APP_STORE_RELEASE_NOTES_MAX_LENGTH]
end


def app_store_processing_wait_timeout_seconds
  raw_value = ENV["APP_STORE_PROCESSING_WAIT_TIMEOUT_SECONDS"].to_s.strip
  return APP_STORE_PROCESSING_WAIT_TIMEOUT_SECONDS if raw_value.empty?

  timeout_seconds = Integer(raw_value, 10)
  UI.user_error!("APP_STORE_PROCESSING_WAIT_TIMEOUT_SECONDS must be positive") unless timeout_seconds.positive?
  timeout_seconds
rescue ArgumentError
  UI.user_error!("APP_STORE_PROCESSING_WAIT_TIMEOUT_SECONDS must be an integer number of seconds")
end

def wait_for_app_store_build_processing!(api_key:, app_version:, build_number:)
  wait_opts = {
    api_key: api_key,
    app_identifier: BUNDLE_ID,
    app_platform: "ios",
    distribute_only: true,
    skip_submission: true,
    distribute_external: false,
    notify_external_testers: false,
    skip_waiting_for_build_processing: false,
    wait_processing_interval: 30,
    wait_processing_timeout_duration: app_store_processing_wait_timeout_seconds
  }

  wait_opts[:app_version] = app_version unless app_version.empty?
  wait_opts[:build_number] = build_number unless build_number.empty?

  upload_to_testflight(wait_opts)
end

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Build signed IPA and upload to TestFlight"
  lane :release do
    api_key = asc_api_key
    ensure_supabase_client_key_env!

    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      readonly: true,
      api_key: api_key
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/#{SCHEME}.xcodeproj",
      team_id: "6QLNK7TXM3",
      code_sign_identity: "Apple Distribution",
      targets: [SCHEME],
      profile_name: "match AppStore #{BUNDLE_ID}",
      bundle_identifier: BUNDLE_ID
    )

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: OUTPUT_DIR,
      output_name: "#{SCHEME}.ipa",
      clean: true,
      silent: false,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "6QLNK7TXM3",
        provisioningProfiles: {
          BUNDLE_ID => "match AppStore #{BUNDLE_ID}"
        }
      }
    )

    # fastlane be56dd5 currently drops --file when wrapping Xcode 26 altool.
    # Keep the Faraday 2 pin and own the upload arguments until that wrapper is fixed upstream.
    # The submit lane performs a separate App Store Connect processing wait before deliver.
    upload_ipa_with_altool!(File.join(OUTPUT_DIR, "#{SCHEME}.ipa"))
  end

  desc "Submit the latest (or specified) TestFlight build for App Store review"
  lane :submit do
    api_key = asc_api_key

    release_notes_text = app_store_release_notes(ENV["IOS_RELEASE_NOTES"])

    deliver_opts = {
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      reject_if_possible: true,
      precheck_include_in_app_purchases: false,
      # IDFA: the admin app uses the advertiser identifier for ad-attribution of
      # Baci's own acquisition marketing (TikTok Business SDK install/action
      # attribution — ADMIN_TIKTOK_APP_ID/SECRET are wired into the release
      # build), gated behind App Tracking Transparency. It does NOT display ads
      # in-app. These flags must match the Apple privacy declaration or the
      # automated review submission is rejected. Mirrors the storefront submit
      # lane, which submits successfully via `deliver` on the same pinned
      # fastlane — `deliver` DOES apply these add_id_info_* fields.
      submission_information: {
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: true,
        add_id_info_tracks_install: true,
        add_id_info_limits_tracking: true,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false
      }
    }

    build_number = ENV["SUBMIT_BUILD_NUMBER"].to_s.strip
    app_version = ENV["SUBMIT_APP_VERSION"].to_s.strip

    if build_number.empty? ^ app_version.empty?
      UI.user_error!(
        "SUBMIT_BUILD_NUMBER and SUBMIT_APP_VERSION must be set together or both left empty. " \
        "Setting only one creates ambiguity about which version to attach the changelog to."
      )
    end

    deliver_opts[:build_number] = build_number unless build_number.empty?
    deliver_opts[:app_version] = app_version unless app_version.empty?

    wait_for_app_store_build_processing!(
      api_key: api_key,
      app_version: app_version,
      build_number: build_number
    )

    changelog_opts = { api_key: api_key, changelog: release_notes_text }
    changelog_opts[:version] = app_version unless app_version.empty?
    set_changelog(changelog_opts)

    deliver(deliver_opts)
  end
end
