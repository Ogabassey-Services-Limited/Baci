default_platform(:ios)

WORKSPACE = "ios/BaciTheEcommerceBuilder.xcworkspace"
SCHEME = "BaciTheEcommerceBuilder"
BUNDLE_ID = "com.ogabassey.baci"
OUTPUT_DIR = File.expand_path("../build", __dir__)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_API_KEY_ID"),
    issuer_id: ENV.fetch("ASC_API_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_API_KEY_PATH"),
    duration: 1200,
    in_house: false
  )
end

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Build signed IPA and upload to TestFlight (no review submission)"
  lane :release do
    api_key = asc_api_key

    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      readonly: true,
      api_key: api_key
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/#{SCHEME}.xcodeproj",
      team_id: "6QLNK7TXM3",
      code_sign_identity: "Apple Distribution",
      targets: [SCHEME],
      profile_name: "match AppStore #{BUNDLE_ID}",
      bundle_identifier: BUNDLE_ID
    )

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: OUTPUT_DIR,
      output_name: "#{SCHEME}.ipa",
      clean: true,
      silent: false,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "6QLNK7TXM3",
        provisioningProfiles: {
          BUNDLE_ID => "match AppStore #{BUNDLE_ID}"
        }
      }
    )

    # Upload to TestFlight only. No review submission here — that's a
    # separate manually-triggered workflow so we can QA in TestFlight first.
    upload_to_testflight(
      api_key: api_key,
      ipa: File.join(OUTPUT_DIR, "#{SCHEME}.ipa"),
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "Submit the latest (or specified) TestFlight build for App Store review"
  lane :submit do
    api_key = asc_api_key

    release_notes_text = ENV["IOS_RELEASE_NOTES"].to_s.strip
    release_notes_text = "Bug fixes and performance improvements." if release_notes_text.empty?

    deliver_opts = {
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      reject_if_possible: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false
      }
    }

    build_number = ENV["SUBMIT_BUILD_NUMBER"].to_s.strip
    app_version = ENV["SUBMIT_APP_VERSION"].to_s.strip

    if build_number.empty? ^ app_version.empty?
      UI.user_error!(
        "SUBMIT_BUILD_NUMBER and SUBMIT_APP_VERSION must be set together or both left empty. " \
        "Setting only one creates ambiguity about which version to attach the changelog to."
      )
    end

    deliver_opts[:build_number] = build_number unless build_number.empty?
    deliver_opts[:app_version] = app_version unless app_version.empty?

    changelog_opts = { api_key: api_key, changelog: release_notes_text }
    changelog_opts[:version] = app_version unless app_version.empty?
    set_changelog(changelog_opts)

    deliver(deliver_opts)
  end
end
