            },
          ],
        },
        order: {
          emoji: '📦',
          title: 'Orders & Tracking',
          items: [
            {
              q: 'How do I track my order?',
              a: 'You can track your order by providing your order number or phone number. Just ask me!',
            },
            {
              q: 'Can I cancel my order?',
