    "expo-updates": "~56.0.19",
    "expo-web-browser": "~56.0.5",
    "lottie-react-native": "~7.3.8",
    "nativewind": "^4.2.5",
    "posthog-react-native": "^4.52.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.79.0",
    "react-native": "0.85.3",
    "react-native-css-interop": "^0.2.5",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~3.0.1",
    "react-native-google-places-autocomplete": "^2.6.4",
    "react-native-keyboard-controller": "1.21.11",
    "react-native-mmkv": "4.3.1",
    "react-native-nitro-modules": "0.35.9",
    "react-native-pager-view": "8.0.1",
    "react-native-reanimated": "4.4.1",
    "react-native-render-html": "6.3.4",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.9.2",
    "tailwindcss": "^4.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@jest/globals": "^29.7.0",
    "@posthog/cli": "^0.7.33",
    "@react-native/metro-config": "0.85.3",
    "@tanstack/query-core": "^5.101.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "plist": "^3.1.1",
    "react-test-renderer": "19.2.3",
    "tsx": "4.22.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "tar": "^7.5.7"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "@shopify/flash-list",
        "lottie-react-native",
        "react-native-gesture-handler",
        "react-native-keyboard-controller",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-svg",
        "react-native-web",
        "react-native-worklets"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false,
        "reason": "Native android/ios projects are committed and are the source of truth for builds; Expo Doctor cannot sync app.config.ts fields in this non-CNG setup, so this documented check is disabled intentionally."
      }
    }
  }
}
