{
  "$schema": "https://turbo.build/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalDependencies": [
    ".npmrc",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    "biome.json",
    "tsconfig*.json"
  ],
  "globalPassThroughEnv": [
    "CEREBRAS_API_KEY",
    "GROQ_API_KEY",
    "OPENROUTER_API_KEY",
    "COPILOT_CEREBRAS_MODEL",
    "COPILOT_GROQ_MODEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_ROOT_DOMAIN",
        "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN",
        "NEXT_PUBLIC_POSTHOG_HOST",
        "NEXT_PUBLIC_POSTHOG_ASSETS_HOST",
        "NEXT_PUBLIC_POSTHOG_UI_HOST",
        "NEXT_PUBLIC_POSTHOG_PROXY_PATH",
        "NEXT_PUBLIC_POSTHOG_RELEASE_VERSION",
        "NEXT_PUBLIC_VERCEL_GIT_COMMIT_REF",
        "NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA",
        "NEXT_PUBLIC_VERCEL_ENV",
        "NEXT_PUBLIC_VERCEL_URL",
        "POSTHOG_PROJECT_TOKEN",
        "POSTHOG_HOST",
        "POSTHOG_API_KEY",
        "POSTHOG_PROJECT_ID",
        "POSTHOG_RELEASE_VERSION",
        "BACI_NEXT_DEPLOYMENT_ID_SOURCE",
        "NEXT_DEPLOYMENT_ID",
        "VERCEL_DEPLOYMENT_ID",
        "VERCEL_GIT_COMMIT_REF",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_ENV",
        "VERCEL_URL",
        "GITHUB_REF_NAME",
        "GITHUB_SHA",
        "SUPABASE_SERVICE_ROLE_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "JUMIA_CLIENT_ID",
        "JUMIA_CLIENT_SECRET",
        "JUMIA_ENVIRONMENT",
        "EXPO_ACCESS_TOKEN",
        "INTERNAL_API_SECRET",
        "CRON_SECRET",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ZONE_ID",
        "QUIZ_PHASE",
        "QUIZ_PRODUCTION_APPROVED",
        "QUIZ_RPC_SERVER_SECRET",
        "QUIZ_APP_INTEGRITY_TIER_OVERRIDES_JSON",
        "IMPORT_JOB_WORKER_SECRET",
        "IMPORT_JOB_WORKER_BATCH_SIZE",
        "IMPORT_JOB_DIRECT_UPLOAD_ENABLED",
        "MONNIFY_API_KEY",
        "MONNIFY_SECRET_KEY",
        "MONNIFY_BASE_URL",
        "PETROCK_API_BASE_URL",
        "PETROCK_API_TOKEN",
        "PETROCK_ENABLED",
        "PETROCK_ENABLED_TIERS",
        "PETROCK_REMEDIATION_ENABLED",
        "USDT_WALLET_ENABLED",
        "NEXT_PUBLIC_WALLET_ORDER_AUTO_DEBIT_ENABLED",
        "IMEI_FX_NGN_USD",
        "IMEI_DISABLED_TIERS",
        "IMEI_IDENTIFIER_ENCRYPTION_KEY",
        "GIGL_ENABLED",
        "GIGL_BASE_URL",
        "GIGL_EMAIL",
        "GIGL_PASSWORD",
        "GIGL_QUOTE_TIMEOUT_MS",
        "GIGL_BOOKING_TIMEOUT_MS",
        "GIGL_TRACKING_TIMEOUT_MS",
        "GIGL_STATIONS_TIMEOUT_MS",
        "TOPSHIP_ENABLED",
        "TOPSHIP_API_KEY",
        "TOPSHIP_USE_SANDBOX",
        "TOPSHIP_BASE_URL",
        "TOPSHIP_SANDBOX_URL",
        "CAC_API_URL",
        "OLLAMA_BASE_URL",
        "OLLAMA_CAC_MODEL",
        "OLLAMA_BASIC_AUTH",
        "LLM_SERVER_URL",
        "LLM_SERVER_BEARER",
        "LLM_CHAT_MODEL",
        "SUPABASE_JWT_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "next.config*.ts",
        "$TURBO_ROOT$/biome.json"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "next.config*.ts",
        "$TURBO_ROOT$/tsconfig*.json"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "next.config*.ts",
        "$TURBO_ROOT$/tsconfig*.json",
        "vitest.config.*",
        "jest.config.*"
      ]
    }
  }
}
