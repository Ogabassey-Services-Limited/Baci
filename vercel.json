{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm turbo build --filter=@baci/web",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "ignoreCommand": "exit 0",
  "crons": [
    {
      "path": "/api/cron/push-receipts",
      "schedule": "0,30 * * * *"
    },
    {
      "path": "/api/cron/cleanup-push-tokens",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/inventory/push-alerts",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/process-import-jobs",
      "schedule": "* * * * *"
    }
  ]
}
