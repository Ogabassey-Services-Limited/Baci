{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm turbo build --filter=@baci/web",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "ignoreCommand": "npx -y turbo-ignore",
  "crons": [
    {
      "path": "/api/ai-jobs/worker",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/cleanup-orders",
      "schedule": "0 0 * * *"
    }
  ]
}