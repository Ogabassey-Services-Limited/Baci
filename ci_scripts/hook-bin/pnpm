#!/usr/bin/env bash
set -euo pipefail

real_pnpm="${BACI_REAL_PNPM:?BACI_REAL_PNPM is unset}"
scripts_dir=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd -P)

case "${1:-}" in
  install|i|add)
    if sh "$scripts_dir/is-sparse-checkout.sh"; then
      exec "$real_pnpm" --config.allowUnusedPatches=true "$@"
    fi
    ;;
esac

exec "$real_pnpm" "$@"
