+afterEvaluate {
+    tasks.matching { task -> task.name ==~ /parse.+LocalResources/ }.configureEach { parseTask ->
+        def variantName = parseTask.name
+            .replaceFirst(/^parse/, "")
+            .replaceFirst(/LocalResources$/, "")
+        def variantDir = variantName[0].toLowerCase() + variantName.substring(1)
+        def symbolFile = layout.buildDirectory.file(
+            "intermediates/local_only_symbol_list/${variantDir}/${parseTask.name}/R-def.txt"
+        )
+        outputs.file(symbolFile)
+        doLast {
+            def output = symbolFile.get().asFile
+            if (!output.exists()) {
+                output.parentFile.mkdirs()
+                output.text = ""
+            }
+        }
+    }
+}
