  "pnpm": {
    "overrideNotes": {
      "defu": "Pin to 6.1.6 to mitigate GHSA-737v-mqg7-c878 / CVE-2026-35209: replace the vulnerable transitive deep-merge helper.",
      "@xmldom/xmldom": "Pin to 0.8.13 to mitigate GHSA-f6ww-3ggp-fr8h, GHSA-2v35-w6hq-6mfw, GHSA-j759-j44w-7fr8, and GHSA-x6wf-f3px-wcqx: keep Expo plist tooling on the patched 0.8.x line.",
      "fast-xml-parser": "Pin to 5.7.2 to mitigate GHSA-gh4j-gqv2-49f6 in XMLBuilder comment/CDATA serialization while keeping transitive feed and storage XML tooling on the patched 5.x line.",
      "std-env": "Pin to 4.1.0 so Vitest 4.x can import isAgent from a compatible std-env release.",
      "tinyrainbow": "Pin to 3.1.0 so Vitest 4.x consumers resolve a compatible color utility during CLI startup.",
      "postcss": "Pin to 8.5.10 to mitigate GHSA-qx2v-qp2m-jg93 in CSS stringify output.",
      "uuid@<7": "Pin legacy uuid v3/v5/v6 consumers to 14.0.0 to mitigate GHSA-w5hq-g745-h8pq buffer bounds handling. Scoped to <7 so xcode@3.0.1 keeps its CommonJS-compatible uuid@7.0.3 resolution; uuid v12+ is ESM-only and breaks Expo prebuild flows.",
      "next": "Pin to 16.2.4 to mitigate GHSA-q4gf-8mx6-v5v3 in Server Components.",
      "basic-ftp": "Pin to 5.3.0 to mitigate GHSA-rp42-5vxx-qpwr via transitive Lighthouse tooling.",
      "ajv@<6.14.0": "Pin legacy AJV 6 consumers to 6.14.0 to mitigate GHSA-2g4f-4pwh-qvx6 without forcing AJV 8 into older consumers.",
      "@types/react": "Dedupe to a single version. Without this, pnpm hoists 19.2.13 at the root and nested copies at 19.2.14, causing TS2769 'two different types with this name' errors on react-native ref props."
    },
