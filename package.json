{
  "name": "@baci/monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check:platform-drift": "pnpm --filter baci-mobile-admin check:platform-drift && pnpm --filter @baci/mobile-storefront check:platform-drift",
    "check:route-size": "pnpm --filter @baci/mobile-storefront check:route-size",
    "start": "turbo start",
    "lint": "turbo lint",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "knip": "knip --no-exit-code",
    "react-doctor": "pnpm dlx react-doctor@0.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@eslint/js": "^10.0.0",
    "@hono/node-server": "^2.0.2",
    "eslint": "^10.4.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "hono": "^4.12.23",
    "knip": "^5.83.1",
    "lefthook": "^2.1.0",
    "next": "16.2.9",
    "tailwindcss": "^4.2.2",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "zod": "^4.4.3"
  }
}
