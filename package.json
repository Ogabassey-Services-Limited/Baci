{
  "name": "@baci/monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check:platform-drift": "pnpm --filter baci-mobile-admin check:platform-drift && pnpm --filter @baci/mobile-storefront check:platform-drift",
    "check:route-size": "pnpm --filter @baci/mobile-storefront check:route-size",
    "start": "turbo start",
    "lint": "turbo lint",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "knip": "knip --no-exit-code"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@eslint/js": "^10.0.0",
    "@hono/node-server": "^2.0.2",
    "hono": "^4.12.16",
    "knip": "^5.83.1",
    "lefthook": "^2.1.0",
    "next": "16.2.6",
    "tailwindcss": "^4.2.2",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
