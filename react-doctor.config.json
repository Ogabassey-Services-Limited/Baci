{
  "serverAuthFunctionNames": [
    "ensurePermission"
  ],
  "ignore": {
    "files": [
      "**/scripts-tmp/**",
      "**/vps-workers/**",
      "**/supabase/functions/**",
      "**/cloudflare-gemini-proxy/**",
      "**/public/**",
      "**/with-ios-release-hardening.js",
      "**/database.types.ts",
      "**/supabase.ts",
      "**/types/cac.ts",
      "**/*.cjs",
      "**/*.mjs",
      "**/test_review.js",
      "**/migrate_images.ts"
    ],
    "overrides": [
      {
        "files": [
          "**/apps/mobile-admin/**",
          "**/apps/mobile-storefront/**"
        ],
        "rules": [
          "nextjs-no-img-element",
          "nextjs-no-a-element",
          "nextjs-no-client-side-redirect",
          "nextjs-no-client-fetch-for-server-data",
          "nextjs-no-redirect-in-try-catch",
          "rendering-hydration-mismatch-time"
        ]
      }
    ]
  }
}
