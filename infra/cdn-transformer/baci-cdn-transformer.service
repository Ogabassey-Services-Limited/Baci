[Unit]
Description=Baci CDN image transformer
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=bassey
Group=bassey
WorkingDirectory=/home/bassey/baci-cdn-transformer
Environment=NODE_ENV=production
Environment=CDN_TRANSFORMER_HOST=127.0.0.1
Environment=CDN_TRANSFORMER_PORT=8095
Environment=CDN_PUBLIC_ROOT=/home/bassey/baci-cdn/public
Environment=CDN_TRANSFORMER_CACHE_ROOT=/home/bassey/baci-cdn/cache/image-transform
ExecStart=/usr/bin/node /home/bassey/baci-cdn-transformer/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStartSec=10
TimeoutStopSec=15
LimitNOFILE=4096
# The live Node/Sharp process idles above 100 threads on this VPS; 128 prevented startup.
# Keep process/thread headroom above the measured baseline while MAX_CONCURRENT_TRANSFORMS limits work.
LimitNPROC=512
MemoryAccounting=yes
CPUAccounting=yes
# Sharp transforms can spike memory during resize/encode; cap at 1G and alert before sustained 80% usage.
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
SystemCallFilter=~@raw-io
ReadWritePaths=/home/bassey/baci-cdn/cache

[Install]
WantedBy=multi-user.target
