[Unit]
Description=Baci CWV lease-bound local host sampler

[Service]
Type=oneshot
User=root
Group=baci-cwv
Slice=cwv-measurement-control.slice
EnvironmentFile=/run/baci-cwv/host-sampler.env
ExecStart=/usr/bin/node /srv/baci-cwv/sealed/host-sample-publisher.mjs live ${BACI_CWV_CAMPAIGN_ID}
Restart=no
TimeoutStartSec=30s
TimeoutStopSec=15s
RuntimeMaxSec=30s
KillMode=control-group
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/baci-cwv/evidence
