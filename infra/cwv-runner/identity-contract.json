    "service": { "keys": ["manifestSha256", "schemaVersion", "unitSha256"] },
    "image": {
      "keys": [
        "id",
        "imageReceiptSha256",
        "platform",
        "runtimeIdentitySha256",
        "runtimeManifestSha256",
        "schemaVersion"
      ],
      "platform": "linux/amd64"
    }
