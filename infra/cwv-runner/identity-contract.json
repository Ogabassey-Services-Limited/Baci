      "--proto",
      "=https",
      "--tlsv1.2",
      "--cacert",
      "/etc/ssl/certs/ca-certificates.crt",
      "--fail",
      "--silent",
      "--show-error",
      "--max-time",
      "10"
    ]
  },
  "sourceEnvelope": {
    "keys": ["canonical", "owner", "schemaVersion", "sha256Receipt", "source"],
    "owner": { "uid": 0, "gid": 10001, "mode": "0640" },
    "receipt": "lowercase SHA-256 followed by one LF",
    "canonical": "UTF-8 canonical JSON with sorted object keys and no trailing newline"
  },
  "builderSources": {
    "required": ["policy", "host", "runtime", "github", "service", "image"],
