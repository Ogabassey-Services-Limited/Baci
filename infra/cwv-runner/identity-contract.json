        "path": "/usr/bin/google-chrome-stable",
        "targetPath": "/opt/google/chrome/google-chrome",
        "debianPackage": {
          "architecture": "amd64",
          "name": "google-chrome-stable",
          "version": "150.0.7871.128-1"
        },
        "version": "150.0.7871.128",
