        "hostRunnerIdentityDigest",
        "hostname",
        "schemaVersion"
      ],
      "hostname": "ogabassey",
      "runnerFiles": [
        ".runner",
        "bin/Runner.Listener",
        "bin/Runner.Worker",
        "entrypoint.mjs"
      ],
      "frozenFields": [
        "cgroupDocker",
        "controlCgroup",
        "cpuFreq",
        "cpuSummary",
