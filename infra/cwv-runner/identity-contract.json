      },
      "node": {
        "keys": ["binarySha256", "version"],
        "path": "/opt/node/bin/node",
        "version": "24.18.0"
      },
      "pnpm": {
        "keys": [
          "binarySha256",
          "packageJsonSha256",
          "packageProjection",
          "version"
        ],
        "argv": ["/opt/node/bin/node", "/opt/pnpm/bin/pnpm.cjs", "--version"],
        "packageProjection": {
          "bin": "bin/pnpm.cjs",
          "name": "pnpm",
          "version": "11.7.0"
        },
        "version": "11.7.0"
      },
      "runnerFiles": [
        "bin/Runner.Listener",
        "bin/Runner.Worker",
